---
import { localeFromPath, localizedPath } from '../i18n/locales.mjs';
import { translate } from '../i18n/ui.mjs';
const locale = localeFromPath(Astro.url.pathname);
const t = (key: string) => translate(key, locale);
---

<section class="consent" id="consent" aria-labelledby="consent-title" hidden>
  <div class="inner">
    <p class="title" id="consent-title">{t("Cookies")}</p>
    <p class="text">
      {t("Can this site use Google Analytics cookies to count visits and see which pages are useful? Nothing is loaded unless you accept.")}
      {' '}<a href={localizedPath("/privacy/", locale)}>{t("Website privacy")}</a>
    </p>
    <div class="actions">
      <button type="button" class="btn" data-consent="denied">{t("Reject")}</button>
      <button type="button" class="btn" data-consent="granted">{t("Accept")}</button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var banner = document.getElementById('consent');
    if (!banner || !window.siteConsent) return;

    function show() {
      banner.hidden = false;
    }

    banner.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-consent]');
      if (!btn) return;
      window.siteConsent.set(btn.getAttribute('data-consent'));
      banner.hidden = true;
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-consent-open]')) return;
      e.preventDefault();
      show();
      banner.querySelector('[data-consent="granted"]').focus();
    });

    if (window.siteConsent.get() === null) show();
  })();
</script>

<style>
  .consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 100;
    max-width: 640px;
    margin: 0 auto;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
    font-size: 0.95rem;
  }
  .consent[hidden] {
    display: none;
  }
  .title {
    margin: 0 0 0.25rem;
    font-weight: 700;
  }
  .text {
    margin: 0;
    color: var(--text-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .actions .btn {
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1.25rem;
  }
</style>
