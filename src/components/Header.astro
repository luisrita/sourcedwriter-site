---
import { NAV, SITE } from '../config';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localeFromPath, localizedPath } from '../i18n/locales.mjs';
import { pageAlternates } from '../i18n/pages.mjs';
import { translate } from '../i18n/ui.mjs';

interface Props { alternatives?: ReturnType<typeof pageAlternates>; }
const { alternatives = [] } = Astro.props;
const current = Astro.url.pathname;
const locale = localeFromPath(current);
const t = (key: string) => translate(key, locale);
const href = (path: string) => path === '/blog/' ? path : localizedPath(path, locale);
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href("/")} aria-label={`${SITE.productName}, ${t("Home")}`}>
      <img src="/images/icon-128x128.png" alt="" width="32" height="32" />
      <span>{SITE.shortName} <span class="brand-sub">{t("with Sources")}</span></span>
    </a>
    <nav aria-label={t("Main")}>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={href(item.href)} aria-current={isActive(href(item.href)) ? 'page' : undefined}>
                {locale === "en" ? item.label : t(item.href === "/blog/" && locale !== "en" ? "Guides (English)" : item.label === "Guides" ? "Guides (English)" : item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher alternatives={alternatives} current={localeFromPath(current)} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .brand img {
    border-radius: 8px;
  }
  .brand-sub {
    font-weight: 500;
    color: var(--text-soft);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--text-soft);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }
</style>
