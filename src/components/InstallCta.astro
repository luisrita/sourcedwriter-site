---
import { PLUGIN } from '../config';

interface Props {
  variant?: 'hero' | 'plain';
}

const { variant = 'plain' } = Astro.props;
---

<div class:list={['cta', variant]}>
  <a class="btn" href={PLUGIN.wordpressOrgUrl} rel="external">Get it free on WordPress.org</a>
  <a class="btn btn--ghost" href="/docs/getting-started/">Setup guide</a>
  <p class="status">
    Free · Version {PLUGIN.version} · WordPress {PLUGIN.requiresWp}+ · PHP {PLUGIN.requiresPhp}+
  </p>
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .status {
    flex-basis: 100%;
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
    opacity: 0.8;
  }
  .hero .btn--ghost {
    color: var(--text-hero);
  }
</style>
