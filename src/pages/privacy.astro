---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { breadcrumbNode } from '../lib/schema';
---

<Base
  title="Website privacy policy"
  description="Privacy policy for sourcedwriter.com: no cookies, no analytics, no tracking. For what the WordPress plugin sends and stores, see the plugin privacy documentation."
  schema={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'Website privacy', path: '/privacy/' }])]}
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Legal</p>
      <h1>Website privacy policy</h1>
      <p class="meta">Last updated 29 September 2026</p>

      <p>
        This policy covers the website {SITE.domain}. For what the WordPress plugin sends and stores, see
        <a href="/docs/privacy-and-external-services/">Privacy and external services</a>.
      </p>

      <h2>What this website collects</h2>
      <p>
        Nothing directly. The site is a set of static pages with no cookies, analytics, tracking pixels, embedded
        third-party scripts or forms.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on GitHub Pages. GitHub may log technical data such as visitor IP addresses for security and
        to run the service. See the
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub Privacy Statement</a>.
      </p>

      <h2>Email</h2>
      <p>
        If you email {SITE.contactEmail}, your message and address are used only to reply to you and, if you asked, to
        tell you about launches. They aren't sold or shared, and you can ask for them to be deleted at any time.
      </p>

      <h2>Contact</h2>
      <p>Controller: {SITE.author.name}. Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
    </div>
  </section>
</Base>
